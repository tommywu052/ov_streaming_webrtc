[package]
title = "Isaac Sim 6 Web Viewer"
description = "Viewport-only Isaac Sim 6.0.x with WebRTC application messaging"
version = "1.0.0"
keywords = ["experience", "streaming", "viewer"]

[dependencies]
"isaacsim.exp.full" = {}
"omni.kit.livestream.app" = {}
"ov.web.viewer.backend" = {}

[settings]
app.name = "Isaac-Sim-6-Web-Viewer"
app.version = "1.0.0"
app.vulkan = true
app.enableDeveloperWarnings = false

[settings.app.window]
hideUi = true
title = "Isaac Sim 6 Web Viewer"
drawMouse = true
width = 1280
height = 720

[settings.app.viewport.defaults.hud]
visible = false

[settings.app.livestream]
allowResize = true
outDirectory = "${data}"

[settings.exts."omni.kit.livestream.app"]
primaryStream.signalPort = 49100
primaryStream.streamPort = 47998
primaryStream.allowDynamicResize = false
primaryStream.targetFps = 30
primaryStream.enableEventTracing = true
primaryStream.enableOpenTelemetry = false
primaryStream.streamType = "webrtc"

[settings.exts."omni.services.livestream.session"]
quitOnSessionEnded = false
resumeTimeoutSeconds = 30
waitForSessionReadyEvent = false
